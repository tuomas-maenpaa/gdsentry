# Godot Engine specific files

# Godot project files
*.tscn
*.tres
*.res
*.godot

# Godot import files
*.import

# Godot cache files
.godot/

# Godot editor files
*.uid

# Operating system files
.DS_Store
Thumbs.db

# Build outputs
build/
dist/
*.exe
*.app
artifacts/

# Development files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Temporary files
*.tmp
*.temp

# Test reports (if you want to ignore them)
test_reports/
reports/

# Documentation build files (if you have Sphinx or similar)
docs/build/
docs/_build/

# Container build artifacts (generated from infra/containers/)
Containerfile.*
containerfile.*

# Environment files
.env
.env.local

# Backup files
*.bak
*.orig

# Python bytecode and caches
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Python tool caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# Python package metadata
*.egg-info/
*.egg
.eggs/

# Core dumps
*.core

# Downloaded dependencies
*.zip
*.tar.gz
*.tgz
/godot-*/

# Runtime artifacts directory
.runtime/
